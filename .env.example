APP_NAME="L-PANEL"

APP_ENV=production

APP_KEY=

APP_DEBUG=false

APP_URL=http://localhost



LOG_CHANNEL=stack

LOG_LEVEL=debug





DB_CONNECTION=pgsql

DB_HOST=127.0.0.1

DB_PORT=5432

DB_DATABASE=lpanel

DB_USERNAME=lpanel

DB_PASSWORD=lpanel_password





BROADCAST_DRIVER=log

CACHE_DRIVER=file

FILESYSTEM_DISK=local

QUEUE_CONNECTION=database

SESSION_DRIVER=file

SESSION_LIFETIME=120





REDIS_HOST=127.0.0.1

REDIS_PASSWORD=null

REDIS_PORT=6379





MAIL_MAILER=log

MAIL_HOST=127.0.0.1

MAIL_PORT=2525

MAIL_USERNAME=null

MAIL_PASSWORD=null

MAIL_ENCRYPTION=null

MAIL_FROM_ADDRESS="admin@l-panel.com"

MAIL_FROM_NAME="${APP_NAME}"





OCSERV_DEFAULT_PORT=443

OCSERV_CONFIG_PATH=/etc/ocserv





SSH_TIMEOUT=10
